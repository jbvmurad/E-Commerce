# =============================================================================
# E-COMMERCE SHARED ENVIRONMENT SETTINGS
# =============================================================================
# Run compose with:
#   docker-compose up --build
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# SERVICE PORTS
# =============================================================================
GATEWAY_HTTP_PORT=5000
GATEWAY_HTTPS_PORT=7000
SECURITY_HTTP_PORT=5043
SECURITY_HTTPS_PORT=7170
PROFILE_HTTP_PORT=5003
PROFILE_HTTPS_PORT=7003
AI_HTTP_PORT=5005
AI_HTTPS_PORT=7005

# =============================================================================
# DATABASE PORTS
# =============================================================================
SECURITY_DB_EXTERNAL_PORT=5437
PROFILE_DB_EXTERNAL_PORT=5439
AI_DB_EXTERNAL_PORT=5441

# =============================================================================
# POSTGRESQL CREDENTIALS
# =============================================================================
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-this-postgres-password

# =============================================================================
# DATABASE CONNECTION STRINGS
# Credentials must match POSTGRES_USER and POSTGRES_PASSWORD above.
# =============================================================================
ConnectionStrings__SecurityConnection=Host=security-db;Port=5432;Database=SecurityDb;Username=ecommerce;Password=change-this-postgres-password
ConnectionStrings__ProfileConnection=Host=profile-db;Port=5432;Database=ProfileDb;Username=ecommerce;Password=change-this-postgres-password
ConnectionStrings__AIConnection=Host=ai-db;Port=5432;Database=AIDb;Username=ecommerce;Password=change-this-postgres-password

# =============================================================================
# SHARED JWT
# =============================================================================
Jwt__Issuer=Security
Jwt__Audience=ECommerceClients
Jwt__SecretKey=change-this-jwt-secret-key-minimum-32-characters

# =============================================================================
# SHARED RABBITMQ
# =============================================================================
RABBITMQ_AMQP_PORT=5673
RABBITMQ_UI_PORT=15673
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=change-this-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/
RabbitMq__Enabled=true
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__VirtualHost=/

# =============================================================================
# SHARED REDIS
# If credentials change, update both connection strings below.
# =============================================================================
REDIS_EXTERNAL_PORT=6380
REDIS_USERNAME=ecommerce
REDIS_PASSWORD=change-this-redis-password
Redis__Enabled=true
Redis__DefaultExpirationMinutes=30
Redis__ConnectionString=redis:6379,user=ecommerce,password=change-this-redis-password,abortConnect=false
ConnectionStrings__redis=redis:6379,user=ecommerce,password=change-this-redis-password,abortConnect=false

# =============================================================================
# SHARED AWS / LOCALSTACK
# =============================================================================
LOCALSTACK_EDGE_PORT=14566
STORAGE_PROVIDER=S3
Storage__Provider=S3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=security-local
PROFILE_AWS_S3_BUCKET_NAME=profile-local
AI_AWS_S3_BUCKET_NAME=ai-local

# =============================================================================
# MONITORING
# =============================================================================
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_PASSWORD=change-this-grafana-admin-password
Loki__Url=http://loki:3100

# =============================================================================
# SECURITY ADMIN BOOTSTRAP
# =============================================================================
AdminBootstrap__Email=admin@ecommerce.local
AdminBootstrap__Password=ChangeThisAdminPassword123!
AdminBootstrap__FullName=E-Commerce Admin

# =============================================================================
# DATABASE UI TOOLS
# =============================================================================
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@ecommerce.local
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
REDISINSIGHT_PORT=8001

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
EmailParameters__Host=smtp.gmail.com
EmailParameters__Port=587
EmailParameters__EnableSsl=true
EmailParameters__From=your-email@gmail.com
EmailParameters__Username=your-email@gmail.com
EmailParameters__AppPassword=your-email-app-password

# =============================================================================
# CLIENT APPLICATION LINKS
# =============================================================================
ClientAppUrls__BaseUrl=http://localhost:5173
ClientAppUrls__VerifyEmailPath=/confirm-email
ClientAppUrls__ResetPasswordPath=/reset-password
ClientAppUrls__ChangeEmailPath=/confirm-email-change
