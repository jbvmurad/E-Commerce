# =============================================================================
# API GATEWAY APPLICATION SETTINGS
# =============================================================================
# Shared JWT settings come from the root .env-shared file.
# =============================================================================

# ASPNETCORE
ASPNETCORE_URLS=http://+:8080

# SERVICE URLS (Docker container hostnames)
SECURITY_SERVICE_URL=http://security-api:8080
PROFILE_SERVICE_URL=http://profile-api:8080
AI_SERVICE_URL=http://ai-api:8080

# CORS
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:3000,https://localhost:5173

# APP
OpenApi__Enabled=true
HttpsRedirection__Enabled=false
