# =============================================================================
# SECURITY SERVICE APPLICATION SETTINGS
# =============================================================================
# Shared database/JWT/RabbitMQ/Redis/email/monitoring values come from
# the repository-root .env-shared file.
# =============================================================================

# REDIS INSTANCE PREFIX
Redis__InstanceName=Security:

# GOOGLE EXTERNAL AUTHENTICATION
# Use the same OAuth Web Client ID in the client VITE_GOOGLE_CLIENT_ID setting.
ExternalAuthentication__Google__Enabled=false
ExternalAuthentication__Google__ClientId=

# AWS S3 / LOCALSTACK
AwsS3__Enabled=true
AwsS3__Region=eu-central-1
AwsS3__BucketName=security-local
AwsS3__KeyPrefix=security-media/
AwsS3__ServiceUrl=http://localstack:4566
AwsS3__ForcePathStyle=true
AwsS3__PublicBaseUrl=http://localhost:14566/security-local

# ASP.NET CORE
ASPNETCORE_URLS=http://+:8080

# APPLICATION
OpenApi__Enabled=true
HttpsRedirection__Enabled=false
Database__MigrateOnStartup=true
