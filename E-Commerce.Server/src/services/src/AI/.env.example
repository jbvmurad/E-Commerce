# =============================================================================
# AI SERVICE APPLICATION SETTINGS
# =============================================================================
# Shared database/JWT/RabbitMQ/Redis/monitoring values come from
# the repository-root .env-shared file.
# =============================================================================

# REDIS INSTANCE PREFIX
Redis__InstanceName=AI:

# AI PROVIDER
# The service can start while AI is disabled. Add real Gemini values and set
# AI__Enabled=true when the provider is ready.
AI__Enabled=false
AI__RequestTimeoutSeconds=120
AI__MaxRetries=2
AI__Gemini__ApiKey=
AI__Gemini__Model=
AI__Gemini__ImageModel=
AI__Gemini__BaseUrl=https://generativelanguage.googleapis.com
AI__Gemini__ApiVersion=v1beta

# RATE LIMITS
AI__RateLimits__CustomerRequestsPerMinute=20
AI__RateLimits__SellerRequestsPerMinute=30

# AWS S3 / LOCALSTACK
AwsS3__Enabled=true
AwsS3__Region=eu-central-1
AwsS3__BucketName=ai-local
AwsS3__KeyPrefix=ai-media/
AwsS3__ServiceUrl=http://localstack:4566
AwsS3__ForcePathStyle=true
AwsS3__PublicBaseUrl=http://localhost:14566/ai-local

# ASP.NET CORE
ASPNETCORE_URLS=http://+:8080

# APPLICATION
OpenApi__Enabled=true
HttpsRedirection__Enabled=false
Database__MigrateOnStartup=true
