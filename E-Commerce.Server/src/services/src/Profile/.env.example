# =============================================================================
# PROFILE SERVICE APPLICATION SETTINGS
# =============================================================================
# Shared database/JWT/RabbitMQ/Redis/monitoring values come from
# the repository-root .env-shared file.
# =============================================================================

# REDIS INSTANCE PREFIX
Redis__InstanceName=Profile:

# AWS S3 / LOCALSTACK
AwsS3__Enabled=true
AwsS3__Region=eu-central-1
AwsS3__BucketName=profile-local
AwsS3__KeyPrefix=profile-media/
AwsS3__ServiceUrl=http://localstack:4566
AwsS3__ForcePathStyle=true
AwsS3__PublicBaseUrl=http://localhost:14566/profile-local

# ASP.NET CORE
ASPNETCORE_URLS=http://+:8080

# APPLICATION
OpenApi__Enabled=true
HttpsRedirection__Enabled=false
Database__MigrateOnStartup=true
